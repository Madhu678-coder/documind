# Copy to .env and fill in — never commit real credentials.

# An existing DocuMind admin user (needed to hit GET /eval/results/{id}, which is admin-only)
BENCHMARK_DOCUMIND_ADMIN_EMAIL=YOUR_ADMIN_EMAIL
BENCHMARK_DOCUMIND_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# Where the main DocuMind API is reachable from this service's containers.
# Default assumes DocuMind's docker-compose is running on the same host.
BENCHMARK_DOCUMIND_API_BASE_URL=http://host.docker.internal:8010

# Host folder containing the benchmark dataset (mounted read-only into the api container as /data)
# Only needed if you use the "folder_path" source type.
BENCHMARK_DATASET_HOST_PATH=./datasets

# -- Confluence (source type: confluence) -------------------------------------
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
BENCHMARK_CONFLUENCE_BASE_URL=https://YOUR_DOMAIN.atlassian.net
BENCHMARK_CONFLUENCE_EMAIL=YOUR_ATLASSIAN_ACCOUNT_EMAIL
BENCHMARK_CONFLUENCE_API_TOKEN=YOUR_API_TOKEN

# -- Google Drive (source type: gdrive) ----------------------------------------
# Create a service account + JSON key in Google Cloud Console, enable the Drive API,
# then share the target folder with the service account's email (ends in
# @<project>.iam.gserviceaccount.com) as a Viewer. Drop the downloaded key file at
# rag-benchmark-suite/secrets/gdrive-service-account.json — docker-compose mounts
# that whole folder read-only into the api container as /secrets.
BENCHMARK_GDRIVE_SERVICE_ACCOUNT_JSON=/secrets/gdrive-service-account.json

# -- SharePoint / OneDrive (source type: sharepoint) ---------------------------
# Register an app in Azure AD (Entra ID) with a client secret, grant it the
# Microsoft Graph APPLICATION permission "Sites.Read.All", and have an admin
# grant consent.
BENCHMARK_AZURE_TENANT_ID=YOUR_AZURE_TENANT_ID
BENCHMARK_AZURE_CLIENT_ID=YOUR_AZURE_APP_CLIENT_ID
BENCHMARK_AZURE_CLIENT_SECRET=YOUR_AZURE_APP_CLIENT_SECRET

# -- Question generation (optional) --------------------------------------------
# Draft question generation reuses DocuMind's own chat pipeline (see README.md
# "Question generation") — no extra credentials needed, just a longer/shorter
# ingestion budget than the defaults below if your dataset is unusually large/small.
# BENCHMARK_QUESTION_GEN_INGESTION_TIMEOUT_SECONDS=300
# BENCHMARK_QUESTION_GEN_DEFAULT_COUNT=8
